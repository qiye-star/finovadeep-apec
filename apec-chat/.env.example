# 复制为 .env 并填值，不要提交 .env
# 主模型（OpenAI 兼容协议，默认 DeepSeek）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
APEC_MODEL=deepseek-chat
# 备用模型（千问）
DASHSCOPE_API_KEY=
APEC_FALLBACK_MODEL=qwen-plus
# 允许跨域的来源：上线时改成官网域名，逗号分隔
APEC_ALLOW_ORIGINS=http://localhost:3100,http://localhost:8830
APEC_RATE_PER_MIN=10
# 速览编辑页（/apec/admin/）密码，至少 12 位；留空则编辑功能关闭
APEC_ADMIN_PASSWORD=
# 速览数据目录，留空用与本文件同级的 data/
APEC_DATA_DIR=
